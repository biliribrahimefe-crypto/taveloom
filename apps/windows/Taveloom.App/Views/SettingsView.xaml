<UserControl x:Class="Taveloom.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="36,30,36,30" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,22"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                    <CheckBox IsChecked="{Binding StartWithWindows}" Content="Start Taveloom when I sign in to Windows"/>
                    <CheckBox IsChecked="{Binding MinimizeToTray}" Content="Keep running in the system tray when the window is closed" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                    <TextBlock Text="Theme" Style="{StaticResource RowLabel}"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="200" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Connection" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                    <CheckBox IsChecked="{Binding LanExposure}" Content="Allow phones on my local network to connect"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="50,4,0,0" Text="Only private-network addresses are ever accepted. Turn this off to disable phone access entirely."/>
                    <TextBlock Text="Port" Style="{StaticResource RowLabel}" Margin="0,16,0,0"/>
                    <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding PortError}" Foreground="{DynamicResource Danger}" Visibility="{Binding PortError, Converter={StaticResource NullToVis}}" Margin="0,4,0,0"/>
                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="12,8" Margin="0,14,0,0" HorizontalAlignment="Left"
                            Visibility="{Binding RestartNeeded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Restart Taveloom to apply connection changes. Paired phones will need the new port, so re-pair if they stop connecting."/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Workspaces" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                    <CheckBox IsChecked="{Binding AutoSwitch}" Content="Switch workspaces automatically based on the focused app"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="50,4,0,0" Text="Rules are edited per workspace in Workspace Studio. Choosing a workspace by hand pauses switching until you resume it."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Security" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                               Text="Phones connect over TLS to a certificate generated on this PC and pinned through the pairing QR code. New devices need your approval here, and the phone can only trigger actions you configured. Credentials are protected with Windows DPAPI."/>
                    <TextBlock Text="Host certificate fingerprint (SHA-256)" Style="{StaticResource RowLabel}" Margin="0,14,0,4"/>
                    <TextBox Text="{Binding FingerprintFull, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"/>
                    <Button Content="Manage trusted devices" Command="{Binding ManageDevicesCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <TextBlock Text="Taveloom" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Version, StringFormat=Version {0} (pre-release)}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="Developed by EFEDEV · MIT License" Style="{StaticResource Muted}" Margin="0,2,0,10"/>
                    <TextBlock Text="Your workspace, at your fingertips." Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding DataDir, StringFormat=Data folder: {0}}" Style="{StaticResource Muted}" Margin="0,10,0,6"/>
                    <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
