<Window x:Class="Taveloom.App.Views.PairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair a phone" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}" Icon="/Assets/taveloom.png">
    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="Pair a phone" Style="{StaticResource H1}"/>
        <TextBlock Text="Open Taveloom on your Android device, tap “Scan code” and point it here. Your PC will ask you to approve the device." Style="{StaticResource Muted}" Margin="0,6,0,18"/>

        <Border Background="White" CornerRadius="14" Padding="14" HorizontalAlignment="Center">
            <Grid Width="260" Height="260">
                <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Border x:Name="Expired" Background="#EEFFFFFF" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Code expired" Foreground="#14171F" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Generate a new one to continue." Foreground="#5B6372" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="Countdown" HorizontalAlignment="Center" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
        <Border x:Name="StatusBox" CornerRadius="8" Padding="12,9" Margin="0,14,0,0" Background="{DynamicResource SurfaceAlt}">
            <TextBlock x:Name="Status" Text="Waiting for your phone…"/>
        </Border>
        <TextBlock x:Name="Addresses" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="New code" Click="OnNewCode" Margin="0,0,8,0"/>
            <Button Content="Done" Style="{StaticResource PrimaryButton}" Click="OnDone" MinWidth="90" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
