<Window x:Class="Taveloom.App.Views.ApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approve device" Width="440" SizeToContent="Height" ResizeMode="NoResize" Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}" Icon="/Assets/taveloom.png">
    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="Allow this device?" Style="{StaticResource H1}"/>
        <TextBlock x:Name="Message" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="DeviceName" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="Address" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,0" FontSize="12"
                   Text="Only approve a device you just paired yourself. It will be able to run the actions in your workspaces on this PC until you revoke it."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Deny" Click="OnDeny" Margin="0,0,8,0" MinWidth="90"/>
            <Button Content="Allow" Style="{StaticResource PrimaryButton}" Click="OnAllow" MinWidth="90"/>
        </StackPanel>
    </StackPanel>
</Window>
