<UserControl x:Class="Taveloom.App.Views.StudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <DataTemplate x:Key="IconItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Converter={StaticResource IconGlyph}}" Width="26"/>
                <TextBlock Text="{Binding}"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11.5"/><Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,26,28,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- Workspace list -->
        <DockPanel Margin="0,0,20,0">
            <TextBlock DockPanel.Dock="Top" Text="Workspaces" Style="{StaticResource H1}" FontSize="20" Margin="0,0,0,14"/>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button Content="New workspace" Style="{StaticResource PrimaryButton}" Command="{Binding NewWorkspaceCommand}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Content="Duplicate" Command="{Binding DuplicateCommand}"/>
                    <Button Grid.Column="2" Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"/>
                </Grid>
            </StackPanel>
            <ListBox ItemsSource="{Binding List}" SelectedItem="{Binding SelectedItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon, Converter={StaticResource IconGlyph}}" Width="26"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" Margin="8,0,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" ToolTip="Shown on the phone now"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Editor -->
        <ScrollViewer Grid.Column="1" Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVis}}" Padding="0,0,16,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsDirty}"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="90"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Workspace Studio" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Unsaved changes" Style="{StaticResource Muted}" Margin="12,4,0,0" Foreground="{DynamicResource Warning}" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DockPanel>

                <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,12" Visibility="{Binding Message, Converter={StaticResource NullToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding MessageIsError}" Value="True"><Setter Property="Background" Value="#33F2615C"/></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Message}"/>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Icon" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Icons}" SelectedItem="{Binding Icon}" ItemTemplate="{StaticResource IconItem}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Columns" Style="{StaticResource Label}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding ColumnOptions}" SelectedItem="{Binding Columns}"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Rows" Style="{StaticResource Label}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding RowOptions}" SelectedItem="{Binding Rows}"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Layout preview — drag tiles to rearrange, or drag a widget from the palette onto an empty cell." Style="{StaticResource Muted}" Margin="0,16,0,10"/>
                <Border x:Name="PhoneFrame" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5" CornerRadius="26"
                        Padding="16" HorizontalAlignment="Center">
                    <StackPanel>
                        <DockPanel Margin="4,0,4,12" Width="{Binding ActualWidth, ElementName=GridHost}">
                            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{DynamicResource Success}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Grid x:Name="GridHost" AllowDrop="False"/>
                    </StackPanel>
                </Border>

                <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0" x:Name="Palette">
                    <TextBlock Text="Add:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="Button" Tag="Button" Margin="0,0,8,0" Click="OnPaletteClick" PreviewMouseMove="OnPaletteDrag"/>
                    <Button Content="Toggle" Tag="Toggle" Margin="0,0,8,0" Click="OnPaletteClick" PreviewMouseMove="OnPaletteDrag"/>
                    <Button Content="Value" Tag="Value" Margin="0,0,8,0" Click="OnPaletteClick" PreviewMouseMove="OnPaletteDrag"/>
                    <Button Content="Media" Tag="Media" Margin="0,0,8,0" Click="OnPaletteClick" PreviewMouseMove="OnPaletteDrag"/>
                    <Button Content="Volume" Tag="Volume" Click="OnPaletteClick" PreviewMouseMove="OnPaletteDrag"/>
                </WrapPanel>
                <TextBlock Text="Built-in controls do exactly what their label says on this PC. Anything unconfigured shows as unavailable on the phone." Style="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,0" TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Inspector -->
        <ScrollViewer Grid.Column="2" Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="0,0,4,0">
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Control" Style="{StaticResource H2}"/>
                        <TextBlock Text="Select a tile in the preview to edit it." Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding Selected, Converter={StaticResource NullToVis}, ConverterParameter=invert}"/>
                        <StackPanel DataContext="{Binding Selected}" Visibility="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="Label" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>
                            <TextBlock Text="Icon" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding DataContext.Icons, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Icon}" ItemTemplate="{StaticResource IconItem}"/>
                            <TextBlock Text="Widget" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding DataContext.WidgetTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Widget}"/>

                            <StackPanel Visibility="{Binding IsValueWidget, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Value source" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="SourceBox" SelectedItem="{Binding Source}">
                                    <ComboBox.ItemsSource><x:Array Type="{x:Type sys:String}"><sys:String>cpu</sys:String><sys:String>ram</sys:String><sys:String>volume</sys:String><sys:String>mic</sys:String></x:Array></ComboBox.ItemsSource>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsValueWidget, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                <TextBlock Text="Action" Style="{StaticResource Label}"/>
                                <ComboBox ItemsSource="{Binding DataContext.ActionTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding ActionType}"/>
                                <StackPanel Visibility="{Binding NeedsTarget, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Target" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Visibility="{Binding NeedsBrowse, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding TargetHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsLaunchApp, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Arguments (optional)" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Width (cells)" Style="{StaticResource Label}"/>
                                    <ComboBox SelectedItem="{Binding ColSpan}"><ComboBox.ItemsSource><x:Array Type="{x:Type sys:Int32}"><sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32><sys:Int32>3</sys:Int32><sys:Int32>4</sys:Int32></x:Array></ComboBox.ItemsSource></ComboBox></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Height (cells)" Style="{StaticResource Label}"/>
                                    <ComboBox SelectedItem="{Binding RowSpan}"><ComboBox.ItemsSource><x:Array Type="{x:Type sys:Int32}"><sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32><sys:Int32>3</sys:Int32></x:Array></ComboBox.ItemsSource></ComboBox></StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Content="Run on this PC" Command="{Binding DataContext.TestSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Runs the action here so you can check it works"/>
                                <Button Grid.Column="2" Content="Remove" Style="{StaticResource DangerButton}" Command="{Binding DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="Activation rules" Style="{StaticResource H2}"/>
                        <TextBlock Text="Show this workspace when one of these apps is focused. With no rules it is manual-only." Style="{StaticResource Muted}" Margin="0,6,0,6" FontSize="12"/>
                        <CheckBox IsChecked="{Binding IsDefault}" Content="Use as default workspace" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{Binding Rules}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Process (e.g. Code.exe)" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                                                <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Title contains (optional)" Style="{StaticResource Label}" Margin="0,8,0,3"/>
                                                <TextBox Text="{Binding TitleContains, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Priority (higher wins)" Style="{StaticResource Label}" Margin="0,8,0,3"/>
                                                <TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Top" Padding="9,6" MinHeight="0" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Remove rule"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Add rule" Command="{Binding AddRuleCommand}"/>
                            <Button Content="Use last focused app" Command="{Binding AddRuleFromFocusedAppCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="Create a workspace to get started." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasWorkspace, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
    </Grid>
</UserControl>
